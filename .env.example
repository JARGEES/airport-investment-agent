# ============================================================
# Airport Investment Intelligence Agent — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# Only one LLM provider API key is required.

# --- LLM Configuration ---
# Model string in LiteLLM format: "provider/model-name"
# Examples:
#   gemini/gemini-2.5-flash          (Google, generous free tier)
#   anthropic/claude-sonnet-4-20250514         (Anthropic)
#   huggingface/mistralai/Mistral-7B-Instruct-v0.3  (HuggingFace)
#   openai/gpt-4o-mini               (OpenAI)
#   ollama/llama3                     (Local via Ollama)
LLM_MODEL=gemini/gemini-2.5-flash

# --- API Keys (provide the one matching your chosen provider) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=

# --- Analysis Mode ---
# "fast"  = top ~100 busiest airports (faster scoring, lower memory)
# "deep"  = all ~500 commercial airports (comprehensive, slower)
ANALYSIS_MODE=fast

# --- Server ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Data ---
# Number of years of BTS data to download (1-3)
BTS_DATA_YEARS=3
# Timeout in seconds for BTS data download per year (fallback to fewer years on timeout)
BTS_DOWNLOAD_TIMEOUT=120
